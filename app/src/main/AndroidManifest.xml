<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".SubtracksApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Subtracks"
        tools:ignore="DataExtractionRules,UnusedAttribute">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Subtracks"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- A Now Playing widget's settings (UX-45): the launcher opens it, so it is exported for that action only. -->
        <activity
            android:name=".widget.NowPlayingWidgetConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Subtracks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Keeps the app running while a Queue Builder widget Play builds its queue (Android 12+). -->
        <service
            android:name=".widget.QueueBuilderBuildService"
            android:exported="false"
            android:foregroundServiceType="shortService"
            tools:targetApi="31" />

        <receiver
            android:name=".data.download.DownloadCancelReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.NowPlayingWidget"
            android:exported="false"
            android:label="@string/widget_now_playing_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.RecentlyAddedAlbumsWidget"
            android:enabled="@bool/library_widgets_enabled"
            android:exported="false"
            android:label="@string/home_section_recently_added">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recently_added_albums_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.RecentlyPlayedAlbumsWidget"
            android:enabled="@bool/library_widgets_enabled"
            android:exported="false"
            android:label="@string/resources_sort_by_recently_played">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recently_played_albums_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.FavoriteSongsWidget"
            android:enabled="@bool/library_widgets_enabled"
            android:exported="false"
            android:label="@string/home_section_recently_starred">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/favorite_songs_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.RadioStationsWidget"
            android:enabled="@bool/library_widgets_enabled"
            android:exported="false"
            android:label="@string/widget_radio_stations_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/radio_stations_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.QueueBuilderWidget"
            android:enabled="@bool/library_widgets_enabled"
            android:exported="false"
            android:label="@string/queue_builder_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/queue_builder_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
