<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp"
    tools:ignore="UnusedAttribute">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/widget_art_background"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_artwork_placeholder" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_marginStart="16dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                style="@style/Widget.Maekster.NowPlaying.Title"
                android:maxLines="2"
                android:text="@string/widget_nothing_playing"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/widget_artist"
                style="@style/Widget.Maekster.NowPlaying.Artist"
                android:layout_marginTop="2dp"
                android:text="@string/widget_nothing_playing_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                style="@style/Widget.Maekster.NowPlaying.SkipButton"
                android:contentDescription="@string/controls_previous"
                android:src="@drawable/ic_widget_previous" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                style="@style/Widget.Maekster.NowPlaying.PlayButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="8dp"
                android:padding="12dp"
                android:contentDescription="@string/controls_play" />

            <ImageButton
                android:id="@+id/widget_next"
                style="@style/Widget.Maekster.NowPlaying.SkipButton"
                android:contentDescription="@string/controls_next"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
