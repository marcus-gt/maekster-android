<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    tools:ignore="UnusedAttribute">

    <ImageView
        android:id="@+id/widget_art_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_art_background_inset"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        tools:ignore="UnusedAttribute">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/widget_art_background"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_artwork_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                style="@style/Widget.Maekster.NowPlaying.Title"
                android:text="@string/widget_nothing_playing" />

            <TextView
                android:id="@+id/widget_artist"
                style="@style/Widget.Maekster.NowPlaying.Artist"
                android:text="@string/widget_nothing_playing_hint" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_previous"
            style="@style/Widget.Maekster.NowPlaying.SkipButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/controls_previous"
            android:src="@drawable/ic_widget_previous" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            style="@style/Widget.Maekster.NowPlaying.PlayButton"
            android:layout_marginHorizontal="4dp"
            android:contentDescription="@string/controls_play" />

        <ImageButton
            android:id="@+id/widget_next"
            style="@style/Widget.Maekster.NowPlaying.SkipButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/controls_next"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</FrameLayout>
