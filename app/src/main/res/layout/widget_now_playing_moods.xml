<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    tools:ignore="UnusedAttribute">

    <ImageView
        android:id="@+id/widget_art_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_art_background_inset"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="12dp"
        tools:ignore="UnusedAttribute,ContentDescription">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/widget_art_background"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_widget_artwork_placeholder" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="104dp"
                android:layout_marginStart="14dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_title"
                        style="@style/Widget.Maekster.NowPlaying.Title"
                        android:text="@string/widget_nothing_playing"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/widget_artist"
                        style="@style/Widget.Maekster.NowPlaying.Artist"
                        android:layout_marginTop="2dp"
                        android:text="@string/widget_nothing_playing_hint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/widget_previous"
                        style="@style/Widget.Maekster.NowPlaying.SkipButton"
                        android:contentDescription="@string/controls_previous"
                        android:src="@drawable/ic_widget_previous" />

                    <ImageButton
                        android:id="@+id/widget_play_pause"
                        style="@style/Widget.Maekster.NowPlaying.PlayButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="8dp"
                        android:padding="11dp"
                        android:contentDescription="@string/controls_play" />

                    <ImageButton
                        android:id="@+id/widget_next"
                        style="@style/Widget.Maekster.NowPlaying.SkipButton"
                        android:contentDescription="@string/controls_next"
                        android:src="@drawable/ic_widget_next" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- The row below the player, chosen per widget (UX-45): moods, five tiles or a short song list. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp">

            <include
                layout="@layout/widget_mood_row"
                android:layout_width="match_parent"
                android:layout_height="58dp" />

            <LinearLayout
                android:id="@+id/widget_row_tiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/widget_row_tile_0"
                    style="@style/Widget.Maekster.NowPlaying.RowTile">

                    <ImageView
                        android:id="@+id/widget_row_tile_art_0"
                        style="@style/Widget.Maekster.NowPlaying.RowTileArt" />

                    <ImageView
                        android:id="@+id/widget_row_tile_state_0"
                        style="@style/Widget.Maekster.NowPlaying.RowTileState" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_row_tile_1"
                    style="@style/Widget.Maekster.NowPlaying.RowTile">

                    <ImageView
                        android:id="@+id/widget_row_tile_art_1"
                        style="@style/Widget.Maekster.NowPlaying.RowTileArt" />

                    <ImageView
                        android:id="@+id/widget_row_tile_state_1"
                        style="@style/Widget.Maekster.NowPlaying.RowTileState" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_row_tile_2"
                    style="@style/Widget.Maekster.NowPlaying.RowTile">

                    <ImageView
                        android:id="@+id/widget_row_tile_art_2"
                        style="@style/Widget.Maekster.NowPlaying.RowTileArt" />

                    <ImageView
                        android:id="@+id/widget_row_tile_state_2"
                        style="@style/Widget.Maekster.NowPlaying.RowTileState" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_row_tile_3"
                    style="@style/Widget.Maekster.NowPlaying.RowTile">

                    <ImageView
                        android:id="@+id/widget_row_tile_art_3"
                        style="@style/Widget.Maekster.NowPlaying.RowTileArt" />

                    <ImageView
                        android:id="@+id/widget_row_tile_state_3"
                        style="@style/Widget.Maekster.NowPlaying.RowTileState" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_row_tile_4"
                    style="@style/Widget.Maekster.NowPlaying.RowTile">

                    <ImageView
                        android:id="@+id/widget_row_tile_art_4"
                        style="@style/Widget.Maekster.NowPlaying.RowTileArt" />

                    <ImageView
                        android:id="@+id/widget_row_tile_state_4"
                        style="@style/Widget.Maekster.NowPlaying.RowTileState" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_row_songs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_row_song_0"
                    style="@style/Widget.Maekster.NowPlaying.RowSong" />

                <TextView
                    android:id="@+id/widget_row_song_1"
                    style="@style/Widget.Maekster.NowPlaying.RowSong" />

                <TextView
                    android:id="@+id/widget_row_song_2"
                    style="@style/Widget.Maekster.NowPlaying.RowSong" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
