<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="UnusedAttribute,ContentDescription">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/widget_art_background"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_artwork_placeholder" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    style="@style/Widget.Maekster.NowPlaying.Title"
                    android:text="@string/widget_nothing_playing"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/widget_artist"
                    style="@style/Widget.Maekster.NowPlaying.Artist"
                    android:layout_marginTop="2dp"
                    android:text="@string/widget_nothing_playing_hint" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_previous"
                    style="@style/Widget.Maekster.NowPlaying.SkipButton"
                    android:contentDescription="@string/controls_previous"
                    android:src="@drawable/ic_widget_previous" />

                <ImageButton
                    android:id="@+id/widget_play_pause"
                    style="@style/Widget.Maekster.NowPlaying.PlayButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="8dp"
                    android:padding="11dp"
                    android:contentDescription="@string/controls_play" />

                <ImageButton
                    android:id="@+id/widget_next"
                    style="@style/Widget.Maekster.NowPlaying.SkipButton"
                    android:contentDescription="@string/controls_next"
                    android:src="@drawable/ic_widget_next" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_moods"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_mood_night"
            style="@style/Widget.Maekster.NowPlaying.Mood"
            android:background="@drawable/widget_mood_night"
            android:contentDescription="@string/mood_radio_queue_night">

            <ImageView
                style="@style/Widget.Maekster.NowPlaying.MoodIcon"
                android:src="@drawable/ic_widget_mood_night" />

            <TextView
                android:id="@+id/widget_mood_night_label"
                style="@style/Widget.Maekster.NowPlaying.MoodLabel"
                android:text="@string/mood_night" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_mood_energetic"
            style="@style/Widget.Maekster.NowPlaying.Mood"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_mood_energetic"
            android:contentDescription="@string/mood_radio_queue_energetic">

            <ImageView
                style="@style/Widget.Maekster.NowPlaying.MoodIcon"
                android:src="@drawable/ic_widget_mood_energetic" />

            <TextView
                android:id="@+id/widget_mood_energetic_label"
                style="@style/Widget.Maekster.NowPlaying.MoodLabel"
                android:text="@string/mood_energetic" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_mood_workout"
            style="@style/Widget.Maekster.NowPlaying.Mood"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_mood_workout"
            android:contentDescription="@string/mood_radio_queue_workout">

            <ImageView
                style="@style/Widget.Maekster.NowPlaying.MoodIcon"
                android:src="@drawable/ic_widget_mood_workout" />

            <TextView
                android:id="@+id/widget_mood_workout_label"
                style="@style/Widget.Maekster.NowPlaying.MoodLabel"
                android:text="@string/mood_workout" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_mood_chill"
            style="@style/Widget.Maekster.NowPlaying.Mood"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_mood_chill"
            android:contentDescription="@string/mood_radio_queue_chill">

            <ImageView
                style="@style/Widget.Maekster.NowPlaying.MoodIcon"
                android:src="@drawable/ic_widget_mood_chill" />

            <TextView
                android:id="@+id/widget_mood_chill_label"
                style="@style/Widget.Maekster.NowPlaying.MoodLabel"
                android:text="@string/mood_chill" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_mood_focus"
            style="@style/Widget.Maekster.NowPlaying.Mood"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_mood_focus"
            android:contentDescription="@string/mood_radio_queue_focus">

            <ImageView
                style="@style/Widget.Maekster.NowPlaying.MoodIcon"
                android:src="@drawable/ic_widget_mood_focus" />

            <TextView
                android:id="@+id/widget_mood_focus_label"
                style="@style/Widget.Maekster.NowPlaying.MoodLabel"
                android:text="@string/mood_focus" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
