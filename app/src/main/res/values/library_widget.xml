    <string name="widget_chip_not_picked">not picked</string>

    <style name="Widget.Maekster.QueueBuilder.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <style name="Widget.Maekster.QueueBuilder.Chip" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_chip_background</item>
        <!-- Unpicked; the renderer sets each chip's tint. Also what the widget picker preview shows. -->
        <item name="android:backgroundTint">#26FFFFFF</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:textColor">@color/widget_text_primary</item>
        <item name="android:textSize">13sp</item>
        <!-- Large font sizes shrink the label to fit the chip instead of clipping it (the widget is API 31+). -->
        <item name="android:autoSizeTextType" tools:targetApi="26">uniform</item>
        <item name="android:autoSizeMinTextSize" tools:targetApi="26">8sp</item>
        <item name="android:autoSizeMaxTextSize" tools:targetApi="26">13sp</item>
    </style>

    <style name="Widget.Maekster.AlbumShelf.Header" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
