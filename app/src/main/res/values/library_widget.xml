    <string name="widget_recent_albums_description">Play recently added albums from your library</string>
    <string name="widget_recent_albums_no_server">Open maekster to add a server.</string>
    <string name="widget_recent_albums_empty">Open Recently added and sync your library.</string>
    <string name="widget_recently_played_albums_description">Play albums you listened to recently</string>
    <string name="widget_recently_played_albums_empty">Albums you play will show up here.</string>
    <string name="widget_album_action">%1$s: %2$s</string>
    <string name="widget_favorite_songs_description">Play favorite songs from your library</string>
    <string name="widget_favorite_songs_empty">Tap the heart on a song to add it here.</string>
    <string name="widget_favorite_songs_offline_empty">No downloaded favorite songs.</string>
    <string name="widget_radio_stations_label">Radio stations</string>
    <string name="widget_radio_stations_description">Start artist radio and mood radio from your home screen</string>
    <string name="widget_radio_stations_offline">Offline: artist radio plays downloaded songs.</string>
    <string name="widget_queue_builder_description">Pick genres, decades and moods and build a queue from your home screen</string>
    <string name="widget_queue_builder_2000s">2000+</string>
    <string name="widget_queue_builder_90s">90s</string>
    <string name="widget_queue_builder_80s">80s</string>
    <string name="widget_queue_builder_70s">70s</string>
    <string name="widget_queue_builder_older">≤60s</string>
    <string name="widget_queue_builder_2000s_description">2000 and later</string>
    <string name="widget_queue_builder_older_description">The 1960s and before</string>
    <string name="widget_queue_builder_paused">Paused · Play to continue</string>
    <string name="widget_queue_builder_picks_changed">Picks changed · Play builds a new queue</string>
    <string name="widget_row_title">Below the player</string>
    <string name="widget_row_hint">On the large size of this widget. Each Now Playing widget keeps its own choice.</string>
    <string name="widget_row_moods">Mood radios</string>
    <string name="widget_row_recently_added">Recently added albums</string>
    <string name="widget_row_recently_played">Recently played albums</string>
    <string name="widget_row_favorite_songs">Favorite songs</string>
