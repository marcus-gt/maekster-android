<?xml version="1.0" encoding="utf-8"?>
<!-- The Discover Workout card gradient; WidgetMoodColorsTest keeps the stops in step with it. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_ripple">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_inner_radius" />
            <gradient
                android:angle="315"
                android:centerColor="#FFC34622"
                android:endColor="#FF6A1B22"
                android:startColor="#FFDB2E3D" />
        </shape>
    </item>
</ripple>
