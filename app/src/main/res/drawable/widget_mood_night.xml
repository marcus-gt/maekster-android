<?xml version="1.0" encoding="utf-8"?>
<!-- The Discover Night card gradient; WidgetMoodColorsTest keeps the stops in step with it. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_ripple">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_inner_radius" />
            <gradient
                android:angle="315"
                android:centerColor="#FF226BC3"
                android:endColor="#FF281B6A"
                android:startColor="#FF7159E3" />
        </shape>
    </item>
</ripple>
