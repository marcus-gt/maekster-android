<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon for API 24-25, which predate adaptive icons (drawable-anydpi-v26 covers 26+).
     The launcher icons live in drawable rather than mipmap because they are all vectors: mipmap only
     matters for bitmaps (launchers may load a higher density), and mipmap folders accept no vector,
     layer-list or inset XML. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
